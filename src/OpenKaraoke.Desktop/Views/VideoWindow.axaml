<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="clr-namespace:OpenKaraoke.Desktop.Media"
        x:Class="OpenKaraoke.Desktop.Views.VideoWindow"
        Title="노래방 화면"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black"
        Foreground="White"
        FontFamily="Malgun Gothic, Noto Sans CJK KR, Noto Sans KR, sans-serif">

    <!-- 고객용 모니터에 전체화면으로 띄우는 가사(영상) 창. 프레임은 MainWindow가 밀어 넣는다. -->
    <Grid>
        <media:VideoSurface x:Name="VideoCanvas" />
        <TextBlock x:Name="StatusLabel" Margin="96" FontSize="34" FontWeight="Bold"
                   Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
