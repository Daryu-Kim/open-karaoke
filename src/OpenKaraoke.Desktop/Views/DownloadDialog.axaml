<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenKaraoke.Desktop.Views.DownloadDialog"
        Title="{Binding DialogTitle}"
        Width="620"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Malgun Gothic, Noto Sans CJK KR, Noto Sans KR, sans-serif">

    <Window.Styles>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.status.failed">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </Style>
        <Style Selector="TextBlock.status.success">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
        </Style>
    </Window.Styles>

    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding DialogTitle}" FontSize="26" FontWeight="Bold" />
            <TextBlock Classes="muted" FontSize="14" Margin="0,6,0,0"
                       Text="{Binding DescriptionText}" />
        </StackPanel>

        <!-- 미리보기 + 입력 -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="280" Height="158" CornerRadius="12"
                    Background="{DynamicResource Brush.SurfaceAlt}" ClipToBounds="True"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Classes="formlabel" Margin="0,0,0,7" Text="제목" />
                <TextBox Classes="form" Text="{Binding SongTitle}" IsEnabled="{Binding CanStart}" />

                <TextBlock Classes="formlabel" Margin="0,16,0,7" Text="가수" />
                <TextBox Classes="form" Text="{Binding Artist}" IsEnabled="{Binding CanStart}" />

                <TextBlock Classes="formlabel" Margin="0,16,0,7" Text="TJ 번호 (선택)" />
                <TextBox Classes="form" Text="{Binding TjNumber}" IsEnabled="{Binding CanStart}" />
            </StackPanel>
        </Grid>

        <!-- 진행 -->
        <StackPanel Grid.Row="2" Margin="0,22,0,0" IsVisible="{Binding IsBusy}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
            <TextBlock Text="{Binding ProgressText}" FontSize="14" Classes="muted"
                       Margin="0,6,0,0" HorizontalAlignment="Right" />
        </StackPanel>

        <!-- 상태 메시지 -->
        <TextBlock Grid.Row="3" Classes="status" Classes.failed="{Binding IsFailed}"
                   Classes.success="{Binding IsSuccess}"
                   Text="{Binding StatusText}" FontSize="15" Margin="0,14,0,0" TextWrapping="Wrap" />

        <!-- 버튼 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Classes="primary" Content="{Binding StartButtonText}" MinWidth="130" Padding="22,8"
                    Command="{Binding StartDownloadCommand}" />
            <Button Classes="ghost" Content="취소" Margin="10,0,0,0"
                    Command="{Binding CancelCommand}" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
