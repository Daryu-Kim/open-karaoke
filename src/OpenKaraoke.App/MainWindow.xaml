<Window x:Class="OpenKaraoke.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenKaraoke.App.ViewModels"
        Title="Open Karaoke — 노래방"
        Width="1600" Height="900"
        MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Malgun Gothic"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 검색 결과 목록 스타일 -->
        <Style x:Key="ResultListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="14" Padding="14" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ResultListItem}" />
        </Style>

        <!-- 검색 결과 타일 -->
        <DataTemplate DataType="{x:Type vm:SearchResultItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="150" Height="84" CornerRadius="10"
                        Background="{StaticResource Brush.SurfaceAlt}" ClipToBounds="True"
                        HorizontalAlignment="Left">
                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ChannelTitle}" Style="{StaticResource MutedText}"
                               FontSize="15" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="8"
                        Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DurationText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.AccentCyan}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>


    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════ 상단 헤더 ═══════════ -->
        <Grid Grid.Row="0" Height="96">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 로고 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="16"
                        Background="{StaticResource Brush.AccentGradient}">
                    <TextBlock Text="♪" FontSize="30" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="노래방" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="OPEN KARAOKE" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </StackPanel>

            <!-- 검색 영역 -->
            <Grid Grid.Column="1" Margin="36,0,36,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" IsEnabled="False"
                            ToolTip="자모(초성) 검색 — 검색 기능 단계에서 활성화됩니다"
                            Content="자모" />
                    <Button Style="{StaticResource GhostButton}" IsEnabled="False" Margin="6,0,0,0"
                            ToolTip="TJ 번호 검색 — 검색 기능 단계에서 활성화됩니다"
                            Content="TJ 번호" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="12,0,12,0">
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding Search.QueryText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchTextBox_KeyDown"
                             VerticalAlignment="Center" />
                    <TextBlock Text="노래 제목, 가수명 또는 TJ 번호를 입력하세요"
                               Foreground="{StaticResource Brush.TextDim}" FontSize="22"
                               VerticalAlignment="Center" Margin="20,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        Command="{Binding Search.SearchCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconFont}" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="검색" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 오른쪽 버튼 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" ToolTip="설정" IsEnabled="False">
                    <TextBlock Text="&#xE713;" Style="{StaticResource IconFont}" FontSize="22" />
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="10,0,0,0"
                        ToolTip="전체화면 (F)" Command="{Binding ToggleFullscreenCommand}">
                    <TextBlock Text="&#xE740;" Style="{StaticResource IconFont}" FontSize="22" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════ 본문 ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- 좌측: 검색 결과 / 라이브러리 영역 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 영역 탭 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="전체곡" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.AccentCyan}" Margin="0,0,26,0" />
                        <TextBlock Text="인기곡" Style="{StaticResource MutedText}" FontSize="18" Margin="0,0,26,0" />
                        <TextBlock Text="최근곡" Style="{StaticResource MutedText}" FontSize="18" Margin="0,0,26,0" />
                        <TextBlock Text="가수별" Style="{StaticResource MutedText}" FontSize="18" />
                    </StackPanel>

                    <!-- 콘텐츠: 검색 상태에 따라 전환되는 영역 -->
                    <Grid Grid.Row="1" Margin="0,14,0,0" DataContext="{Binding Search}">

                        <!-- 1) 초기 안내 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🎤" FontSize="72" HorizontalAlignment="Center" />
                            <TextBlock Text="곡을 검색하거나 라이브러리에서 선택하세요" FontSize="26" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock Text="위 검색창에 노래 제목이나 가수명을 입력해 주세요"
                                       Style="{StaticResource MutedText}" FontSize="17" HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                        </StackPanel>

                        <!-- 2) 검색 중 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="검색 중..." FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="유튜브에서 MR 영상을 찾고 있습니다" Style="{StaticResource MutedText}"
                                       FontSize="17" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- 3) 검색 결과 -->
                        <Grid Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding ResultSummary}"
                                       Style="{StaticResource MutedText}" FontSize="16" />
                            <ListBox Grid.Row="1" Margin="0,14,0,0"
                                     Style="{StaticResource ResultListBox}"
                                     ItemsSource="{Binding Results}"
                                     SelectedItem="{Binding SelectedResult}"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True" />
                        </Grid>

                        <!-- 4) 결과 없음 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsEmptyResult, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🔍" FontSize="72" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ResultSummary}" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"
                                       TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
                            <TextBlock Text="다른 검색어로 다시 시도해 주세요" Style="{StaticResource MutedText}"
                                       FontSize="17" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>

                        <!-- 5) 오류 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⚠" FontSize="72" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"
                                       TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center" />
                            <TextBlock Text="검색어를 확인하거나 잠시 후 다시 시도해 주세요" Style="{StaticResource MutedText}"
                                       FontSize="17" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 우측: 대기곡 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="대기곡" Style="{StaticResource SectionTitle}" />
                            <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="12"
                                    Padding="10,2" Margin="10,0,0,0">
                                <TextBlock Text="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.AccentCyan}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="전체 삭제" Style="{StaticResource MutedText}" FontSize="14"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 대기곡 빈 상태 -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="♫" FontSize="56" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextDim}" />
                        <TextBlock Text="{Binding QueueStatusText}" Style="{StaticResource MutedText}" FontSize="19"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="검색 결과에서 곡을 선택하면 대기곡에 추가됩니다" FontSize="14"
                                   Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ 하단 PlayerBar ═══════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>

                <!-- 현재 곡 정보 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="104" Height="104" CornerRadius="14"
                            Background="{StaticResource Brush.AccentGradient}">
                        <TextBlock Text="♪" FontSize="44" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NOW PLAYING" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.AccentCyan}" />
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="26" FontWeight="Bold"
                                   MaxWidth="260" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding NowPlayingSubtitle}" Style="{StaticResource MutedText}"
                                   FontSize="15" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 중앙: 진행 + 컨트롤 -->
                <Grid Grid.Column="1" Margin="24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 진행 바 -->
                    <Grid Grid.Row="0" Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" Style="{StaticResource MutedText}"
                                   FontSize="15" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource Brush.SurfaceAlt}"
                                Margin="16,0" VerticalAlignment="Center">
                            <Border Width="0" HorizontalAlignment="Left" Background="{StaticResource Brush.AccentGradient}"
                                    CornerRadius="4" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource MutedText}"
                                   FontSize="15" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 컨트롤 버튼 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource RoundControlButton}" IsEnabled="False" ToolTip="이전 곡 (Shift+N)">
                            <Grid Width="26" Height="26">
                                <Path Data="M 8,4 L 12,4 L 12,28 L 8,28 Z M 26,8 L 15,16 L 26,24 Z"
                                      Fill="{StaticResource Brush.TextPrimary}" Stretch="Uniform" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource PlayButton}" IsEnabled="False" ToolTip="재생 / 일시정지 (Space)"
                                Margin="18,0">
                            <Grid Width="34" Height="34">
                                <Path x:Name="PlayIcon" Data="M 8,2 L 8,30 L 28,16 Z"
                                      Fill="White" Stretch="Uniform" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RoundControlButton}" IsEnabled="False" ToolTip="다음 곡 (N)">
                            <Grid Width="26" Height="26">
                                <Path Data="M 20,4 L 24,4 L 24,28 L 20,28 Z M 6,8 L 17,16 L 6,24 Z"
                                      Fill="{StaticResource Brush.TextPrimary}" Stretch="Uniform" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 우측: 키 / 템포 / 볼륨 -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- KEY -->
                    <Border Grid.Column="0" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="14"
                            Padding="12,10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="KEY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.AccentMagenta}"
                                       HorizontalAlignment="Center" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource StepButton}" IsEnabled="False"
                                        ToolTip="키 내리기 (-)" Content="−" />
                                <TextBlock Grid.Column="1" FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Run Text="{Binding KeySemitones, Mode=OneWay}" /><Run Text=" 반음" />
                                </TextBlock>
                                <Button Grid.Column="2" Style="{StaticResource StepButton}" IsEnabled="False"
                                        ToolTip="키 올리기 (+)" Content="+" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TEMPO -->
                    <Border Grid.Column="1" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="14"
                            Padding="12,10" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="TEMPO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.AccentCyan}"
                                       HorizontalAlignment="Center" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource StepButton}" IsEnabled="False"
                                        ToolTip="템포 느리게 ([)" Content="−" />
                                <TextBlock Grid.Column="1" FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding Tempo, StringFormat=0.00}" />
                                <Button Grid.Column="2" Style="{StaticResource StepButton}" IsEnabled="False"
                                        ToolTip="템포 빠르게 (])" Content="+" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 볼륨 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="&#xE767;" Style="{StaticResource IconFont}" FontSize="24"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="80" Style="{StaticResource MutedText}" FontSize="18" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
